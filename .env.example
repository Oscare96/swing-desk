# Put these in Replit Secrets. Never commit real keys.

# Required
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
DASHBOARD_PASSWORD=

# Recommended: Replit PostgreSQL sets this for you when you add a database
DATABASE_URL=

# Optional phone alerts (free ntfy app) and/or Discord
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=

# Only if [llm] enabled = true in config.toml
ANTHROPIC_API_KEY=

# Backtest data source: alpaca (default) | yfinance | csv
DATA_SOURCE=alpaca
